# Port konfigurasi untuk Web App & API
# Ganti angka di bawah jika port 8000 terpakai / bentrok (contoh: 8001, 8085, dsb)
APP_PORT=8000

# Database URL
# Default SQLite persisten di volume Docker:
DATABASE_URL=sqlite:////app/backend/data/sto.db

# Jika ingin menghubungkan ke MySQL container:
# DATABASE_URL=mysql+pymysql://sto:password@sto-mysql:3306/sto?charset=utf8mb4

# Keamanan JWT (Ganti minimal 32 karakter untuk produksi)
SECRET_KEY=sto-pp2-production-secret-key-change-me-32chars

# Masa berlaku token dalam jam
TOKEN_HOURS=12

# Batas upload file Excel (MB)
MAX_UPLOAD_MB=10

# Generate akun demo (1 = aktif, 0 = nonaktif)
SEED_DEMO=1

# Identitas aplikasi (tampil di UI, judul, ekspor, dan login)
APP_NAME=WMS
APP_SUBTITLE=Warehouse Management System
