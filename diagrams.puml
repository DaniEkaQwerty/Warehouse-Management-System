@startuml WMS_StateSTO
' Diagram 4a — State STO
[*] --> DRAFT
DRAFT --> OPEN
DRAFT --> CANCELLED
OPEN --> COUNTING
OPEN --> CANCELLED
COUNTING --> CHECKING
COUNTING --> CANCELLED
CHECKING --> RECONCILIATION
CHECKING --> COUNTING
CHECKING --> CANCELLED
RECONCILIATION --> COMPLETED
RECONCILIATION --> CHECKING
RECONCILIATION --> CANCELLED
COMPLETED --> [*]
CANCELLED --> [*]
note right of RECONCILIATION
  Gate: semua lokator ACCEPTED
  dan issues == 0 (kecuali force).
end note
@enduml


@startuml WMS_StateLocator
' Diagram 4b — State StoLocator
[*] --> NOT_STARTED
NOT_STARTED --> IN_PROGRESS : MH tambah baris
IN_PROGRESS --> IN_PROGRESS : MH tambah baris
IN_PROGRESS --> WAITING_CHECK : MH selesai
WAITING_CHECK --> ACCEPTED : Checker terima
WAITING_CHECK --> RECOUNT : Checker minta ulang
RECOUNT --> IN_PROGRESS : MH hitung ulang
ACCEPTED --> [*]
@enduml


@startuml WMS_SeqTransaksi
' Diagram 5 — Sequence transaksi barang (offline-first)
actor MH
participant "Mobile PWA" as App
participant "IndexedDB" as IDB
participant "FastAPI /api/m" as API
participant "services/stock.py" as SVC
database DB

MH -> App : Scan item, pilih lokator, isi qty
alt Online
  App -> API : POST /api/m/{inbound|outbound|transfer}
  API -> SVC : create_movement(...)
  SVC -> DB : cek saldo + insert (satu transaksi)
  alt saldo cukup
    DB --> SVC : ok
    SVC --> API : movement
    API --> App : movement_no
    App --> MH : Sukses
  else akan minus
    SVC --> API : 409 "saldo tersedia ..."
    API --> App : error
    App --> MH : Ditolak
  end
else Offline
  App -> IDB : enqueue(client_txn_id, payload)
  App --> MH : Tersimpan offline
  note over App, IDB : Saat online -> flush()
  App -> API : POST /api/m/sync [batch]
  API -> DB : cek client_txn_id (idempoten)
  API --> App : OK / DUPLICATE / REJECTED
end
@enduml


@startuml WMS_SeqSTO
' Diagram 6 — Sequence Stock Opname end-to-end
actor "Supervisor/Admin" as SUP
actor MH
actor Checker as CHK
participant "FastAPI" as API
participant "services/counting|recon" as SVC
database DB

SUP -> API : POST /api/sto (assign counter+checker)
SUP -> API : status OPEN
SUP -> API : status COUNTING
MH -> API : GET /api/m/sto/{id}
MH -> API : POST .../lines (qty)
API -> SVC : add_line (round-based)
MH -> API : POST .../finish
API -> DB : status WAITING_CHECK
CHK -> API : POST .../accept (atau .../recount)
API -> DB : status ACCEPTED
SUP -> API : status CHECKING
SUP -> API : status RECONCILIATION
SUP -> API : GET /api/sto/{id}/reconciliation
API -> SVC : compare(fisik vs ledger) on-the-fly
SVC --> API : MATCH/VARIANCE/MISSING/UNEXPECTED
CHK -> API : POST .../reconciliation/resolve
API -> SVC : resolve -> create ADJUSTMENT
SVC -> DB : insert STOCK_MOVEMENT (ADJUSTMENT)
SUP -> API : status COMPLETED
@enduml


@startuml WMS_SeqPesan
' Diagram 7 — Sequence pesan operator
actor "Admin/Supervisor/Checker" as MGR
actor MH
participant "FastAPI" as API
database DB

MGR -> API : POST /api/messages (target_role, level, body)
API -> DB : insert MESSAGE
API --> MGR : ok
MH -> API : GET /api/m/home
API -> DB : inbox(user) + tasks
API --> MH : messages + unread + tasks
MH -> API : POST /api/m/messages/{id}/read
API -> DB : insert MESSAGE_READ
API --> MH : ok (unread berkurang)
@enduml


@startuml WMS_ActScan
' Diagram 8 — Activity alur scan MH terpadu
start
:Mulai;
if (Pilih jenis transaksi?) then (Masuk)
  :Lokator tujuan;
elseif (Keluar)
  :Lokator asal;
else (Pindah)
  :Lokator asal + tujuan;
endif
:Scan / cari barang;
:Input qty (keypad);
:Pilih ref type/no + catatan;
if (Online?) then (Ya)
  :POST /api/m/...;
  if (Valid?) then (Ya)
    :Sukses + movement_no;
  else (Tidak)
    :Tolak: saldo tersedia;
    stop
  endif
else (Tidak)
  :Enqueue IndexedDB;
  :Tersimpan offline;
endif
stop
@enduml


@startuml WMS_ActSync
' Diagram 9 — Activity sinkronisasi offline
start
:flush;
while (Ada antrean?) is (Ya)
  :POST /api/m/sync atau /api/m/sto/sync;
  if (Hasil per txn) then (OK / DUPLICATE)
    :Hapus dari antrean;
  else (REJECTED)
    :Tandai ditolak + pesan;
  endif
endwhile (Tidak)
if (Ada yang ditolak?) then (Ya)
  :Retry / Discard oleh MH;
endif
stop
@enduml


@startuml WMS_Deployment
' Diagram 10 — Deployment (Docker)
skinparam componentStyle rectangle

node "Perangkat Pengguna" {
  [Browser Mobile (MH / PWA)] as B1
  [Browser Desktop (manajer)] as B2
}

node "Docker Host" {
  node "Container: sto-pp2-app-new" {
    [Uvicorn + FastAPI :8000] as UVI
    [StaticFiles /app/frontend] as STAT
  }
  database "Volume sto-pp2-data\n/app/backend/data\n(sto.db + log)" as VOL
}

B1 --> UVI : HTTP :APP_PORT
B2 --> UVI : HTTP :APP_PORT
UVI --> STAT
UVI --> VOL
@enduml
