@startuml WMS_UseCase
' Diagram 1 — Use Case
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor ADMIN
actor SUPERVISOR
actor CHECKER
actor MH

rectangle "Sistem WMS Operasional" {
  usecase "Login / Logout" as UC_LOGIN
  usecase "Kelola Master\n(Gudang, Lokator, Item, User)" as UC_MASTER
  usecase "Import Master Excel" as UC_IMPORT
  usecase "Cetak Label QR Lokator" as UC_LABEL
  usecase "Lihat Audit Log" as UC_AUDIT
  usecase "Dashboard & Laporan" as UC_DASH
  usecase "Riwayat Stok & Koreksi\n(void / ADJUSTMENT)" as UC_KOREKSI
  usecase "Tangani Transaksi Bermasalah" as UC_PROBLEM
  usecase "Kelola STO\n(buat, penugasan, status)" as UC_STO
  usecase "Verifikasi STO &\nSelesaikan Selisih" as UC_VERIFY
  usecase "Kirim Pesan Operator" as UC_MSG_SEND
  usecase "Transaksi Barang\n(Masuk/Keluar/Pindah)" as UC_SCAN
  usecase "Hitung Fisik Lokator" as UC_COUNT
  usecase "Cek Stok" as UC_STOCK
  usecase "Baca Pesan" as UC_MSG_READ
  usecase "Sinkronisasi Offline" as UC_SYNC
}

ADMIN --> UC_LOGIN
ADMIN --> UC_MASTER
ADMIN --> UC_IMPORT
ADMIN --> UC_LABEL
ADMIN --> UC_AUDIT
ADMIN --> UC_DASH
ADMIN --> UC_STO
ADMIN --> UC_KOREKSI
ADMIN --> UC_MSG_SEND

SUPERVISOR --> UC_LOGIN
SUPERVISOR --> UC_DASH
SUPERVISOR --> UC_STO
SUPERVISOR --> UC_KOREKSI
SUPERVISOR --> UC_MSG_SEND

CHECKER --> UC_LOGIN
CHECKER --> UC_KOREKSI
CHECKER --> UC_PROBLEM
CHECKER --> UC_VERIFY
CHECKER --> UC_MSG_SEND

MH --> UC_LOGIN
MH --> UC_SCAN
MH --> UC_COUNT
MH --> UC_STOCK
MH --> UC_MSG_READ
MH --> UC_SYNC

UC_SCAN ..> UC_SYNC : <<include>>
UC_COUNT ..> UC_SYNC : <<include>>
@enduml


@startuml WMS_Component
' Diagram 2 — Arsitektur / Komponen
skinparam componentStyle rectangle

package "Frontend (Vanilla JS, PWA)" {
  [app.js\nrouter + login] as APP
  [mobile.js\nMH: Beranda/Scan/Akun] as MOB
  [desktop.js\nconsole manajer] as DESK
  [store.js\nIndexedDB + antrean] as STORE
  [ui.js\nkomponen + ikon] as UI
  [api.js\nHTTP client] as APIJS
}

package "Backend (FastAPI)" {
  [routers/*\nauth, master, mobile,\nmovements, imports, reports,\nsto, sto_mobile, messages] as ROUTERS
  [services/*\nstock, counting, recon, export] as SERVICES
  [core.py\nJWT, RBAC, audit, rate-limit] as CORE
  [models.py\nSQLAlchemy 2.0] as MODELS
}

database "SQLite / MySQL\nledger stock_movements" as DB

MOB --> APP
DESK --> APP
MOB --> STORE
MOB --> UI
DESK --> UI
APP --> APIJS
APIJS --> ROUTERS : REST /api
ROUTERS --> SERVICES
ROUTERS --> CORE
SERVICES --> MODELS
CORE --> MODELS
MODELS --> DB
@enduml


